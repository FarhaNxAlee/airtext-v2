{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This targets the REAL, already-live Worker (air4share.farhanwebuse.workers.dev)
  // and its REAL D1/R2/KV resources. `wrangler dev` uses local simulated
  // versions of these by default — only `wrangler deploy` touches production.
  "name": "air4share",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "account_id": "1bda1bde506a5819776160299196e802",
  "preview_urls": false,
  "vars": { "ENVIRONMENT": "production", "BUILD_SHA": "local" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "secrets": { "required": ["APP_SECRET"] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airtext",
      "database_id": "6da609ba-b618-42e0-a118-a1284020a049"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "airtext"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHARE_KV",
      "id": "f0905b728d8642df9df5e7e167c52ab0"
    }
  ]
  , "env": {
    "staging": {
      "name": "air4share-staging",
      "vars": { "ENVIRONMENT": "staging", "BUILD_SHA": "local" },
      "secrets": { "required": ["APP_SECRET"] },
      "triggers": { "crons": ["*/5 * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [{ "binding": "DB", "database_name": "airtext-staging", "database_id": "a722430f-7db8-4a09-884b-ebf004572107" }],
      "r2_buckets": [{ "binding": "FILES_BUCKET", "bucket_name": "airtext-staging" }],
      "kv_namespaces": [{ "binding": "SHARE_KV", "id": "68aed641bc22410795ea2b2f7824ba2f" }]
    }
  }
  // APP_SECRET is a real secret — set via `wrangler secret put APP_SECRET`.
  // Never add them here as `vars`.
}
